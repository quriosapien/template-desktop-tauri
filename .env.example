# ── UI (exposed to the webview bundle — never put secrets in VITE_* vars) ──
VITE_APP_NAME=template-desktop-tauri
# Relative works in dev (the Vite server answers it). Release builds need an
# absolute URL — set it in .env.production — AND its origin added to
# connect-src in src-tauri/tauri.conf.json's `csp` (see README → Environment).
VITE_API_BASE_URL=/api

# ── Dev server only (read by vite.config.ts in Node; never reaches the UI) ──
# Serve the MSW handlers in src/mocks/ from the Vite dev server.
DEV_MOCK_API=true
# Flip DEV_PROXY=true and DEV_MOCK_API=false to hit a real backend instead.
DEV_PROXY=false
DEV_PROXY_TARGET=http://localhost:3000
