{
  "name": "template-desktop-tauri",
  "version": "0.1.0",
  "description": "Production-grade Tauri 2 + Vue 3 + TypeScript desktop template (Vite, Rust shell, keychain-backed JWT auth, auto-update).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "npm run typecheck && vite build",
    "dist": "tauri build",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci .",
    "format": "biome format --write .",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "msw": "^3.0.3",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "lefthook@2.2.2": true
  }
}
