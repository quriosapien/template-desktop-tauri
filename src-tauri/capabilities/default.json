{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least privilege for the main window: the app's own commands and menu events — no plugin APIs, no core:default.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-settings-get",
    "allow-settings-set",
    "allow-update-check",
    "allow-update-install",
    "allow-open-external"
  ]
}
